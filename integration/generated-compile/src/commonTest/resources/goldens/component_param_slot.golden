package dev.rotalex.lutter.generated.component_param_slot.screens

import androidx.compose.foundation.layout.Arrangement
import androidx.compose.foundation.layout.Column
import androidx.compose.material3.Button
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.Stable
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.remember
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.dp
import dev.rotalex.lutter.generated.component_param_slot.components.c_badge

@Stable
public class HomeScreenState {
    public var label: String by mutableStateOf("Live")
}

@Composable
public fun rememberHomeScreenState(): HomeScreenState {
    val state: HomeScreenState = remember {
        HomeScreenState()
    }
    return(state)
}

@Composable
public fun HomeScreen(modifier: Modifier = Modifier, state: HomeScreenState = rememberHomeScreenState()) {
    Column(
        verticalArrangement = Arrangement.spacedBy(8.0.dp),
        modifier = modifier,
    ) {
        Text("Badges")
        c_badge(
            label = state.label,
            accent = Color(0xFFFFB300),
            modifier = Modifier,
        ) {
            Text("amber body")
        }
        c_badge(
            label = "Idle",
            accent = Color(0xFF1B5E20),
            modifier = Modifier,
        ) {
            Text("green body")
        }
        Button(
            onClick = {
                state.label = "Tapped"
            },
        ) {
            Text("Tap")
        }
    }
}
