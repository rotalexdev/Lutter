package dev.rotalex.lutter.generated.text_field_state

import androidx.compose.runtime.Composable
import androidx.compose.runtime.CompositionLocalProvider
import androidx.compose.runtime.remember
import androidx.compose.ui.Modifier
import dev.rotalex.lutter.generated.text_field_state.screens.HomeScreen
import dev.rotalex.lutter.generated.text_field_state.state.AppState
import dev.rotalex.lutter.generated.text_field_state.state.LocalAppState

@Composable
public fun AppRoot(navigator: AppNavigator, modifier: Modifier = Modifier) {
    val state: AppState = remember {
        AppState()
    }
    CompositionLocalProvider(
        LocalAppState.provides(state),
    ) {
        when (navigator.current) {
            Route.Home -> {
                HomeScreen(
                    modifier = modifier,
                )
            }
        }
    }
}
