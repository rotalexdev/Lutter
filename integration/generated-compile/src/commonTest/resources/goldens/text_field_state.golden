package dev.rotalex.lutter.generated.text_field_state.screens

import androidx.compose.foundation.layout.Column
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.Stable
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.remember
import androidx.compose.runtime.setValue
import androidx.compose.ui.Modifier

@Stable
public class HomeScreenState {
    public var count: Int by mutableStateOf(0)

    public var label: String by mutableStateOf("Clicks")

    public val doubled: Int
        get() = count + 1
}

@Composable
public fun rememberHomeScreenState(): HomeScreenState {
    val state: HomeScreenState = remember {
        HomeScreenState()
    }
    return(state)
}

@Composable
public fun HomeScreen(modifier: Modifier = Modifier, state: HomeScreenState = rememberHomeScreenState()) {
    Column(
        modifier = modifier,
    ) {
        Text(state.label)
        Text("Total")
    }
}
