// Generated by Lutter. A plain JVM application: the window it will show comes from
// the shared module once the generated UI is wired into `main`.

import org.jetbrains.kotlin.gradle.dsl.JvmTarget

plugins {
    alias(libs.plugins.kotlinJvm)
    application
}

application {
    mainClass.set("com.example.sample.desktopapp.MainKt")
}

kotlin {
    compilerOptions {
        jvmTarget.set(JvmTarget.fromTarget(libs.versions.jvmTarget.get()))
    }
}

dependencies {
    implementation(project(":shared"))
}

