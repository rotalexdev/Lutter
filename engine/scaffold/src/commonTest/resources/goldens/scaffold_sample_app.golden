### file: androidApp/build.gradle.kts
// Generated by Lutter. No `org.jetbrains.kotlin.android`: AGP 9 compiles Kotlin itself,
// and applying the old plugin beside it is a build failure rather than a warning.
// No `kotlin { compilerOptions { jvmTarget } }` either: built-in Kotlin takes it from
// `compileOptions.targetCompatibility`, so setting both would be one number twice.

plugins {
    alias(libs.plugins.androidApplication)
}

android {
    namespace = "com.example.sample.androidapp"
    compileSdk = libs.versions.androidCompileSdk.get().toInt()

    defaultConfig {
        applicationId = "com.example.sample"
        minSdk = libs.versions.androidMinSdk.get().toInt()
        targetSdk = libs.versions.androidCompileSdk.get().toInt()
        versionCode = 1
        versionName = "1.0"
    }

    compileOptions {
        sourceCompatibility = JavaVersion.toVersion(libs.versions.jvmTarget.get())
        targetCompatibility = JavaVersion.toVersion(libs.versions.jvmTarget.get())
    }
}

dependencies {
    implementation(project(":shared"))
}

